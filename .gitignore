# Local configuration files (not to be committed)
*.local

# Backup directories created during installation
.dotfiles_backup_*/

# Editor and IDE files
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.project
.settings/
.classpath

# OS files
.DS_Store
Thumbs.db

# Testing artifacts
*.log
*.tmp

# Devcontainer CLI build artifacts (generated, not source)
.devcontainer/*/devcontainer-lock.json

# Zsh compiled files
*.zwc

# Any private or sensitive data
secrets/
private/
.pushover-creds

# User-specific bin scripts (if any)
bin/private/

# Prevent circular symlinks (files with same name as parent directory)
bin/bin
claude-code/agents/agents
claude-code/commands/commands
claude-code/hooks/hooks
config/bat/bat
config/bottom/bottom
config/lazygit/lazygit
config/ripgrep/ripgrep
git/hooks/hooks

# git-lfs hooks (if using git-lfs, these are generated and should not be committed)
# post-checkout is deliberately NOT ignored: the tracked worktree-provisioning
# hook chains `git lfs post-checkout` itself, so `git lfs install` is not
# needed for that hook (and would show as a tracked-file modification if run).
git/hooks/post-commit
git/hooks/post-merge
git/hooks/pre-push
