      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git -C:*)",
      "Bash(git stash list:*)",
      "Bash(git tag:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git shortlog:*)",
      "Bash(git describe:*)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
