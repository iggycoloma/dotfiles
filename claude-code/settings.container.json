      "Bash(make test:*)",
      "Bash(shellcheck:*)",
      "Bash(bash -n:*)",
      "Bash(ast-grep:*)",
      "Bash(sg:*)",
      "Bash(difft:*)",
      "Bash(sd:*)",
      "Bash(scc:*)",
      "Bash(bat:*)",
      "Bash(watchexec:*)",
      "Bash(node --version:*)",
      "Bash(npm list:*)",
      "Bash(npx:*)",
      "Bash(python3 --version:*)",
      "Bash(go version:*)",
      "Bash(rustc --version:*)",
      "Bash(claude --version:*)",
      "Bash(codex --version:*)",
      "Bash(dpkg -l:*)",
      "Bash(snap list:*)",
      "Bash(apt list:*)",
      "Bash(brew list:*)",
      "Bash(chmod:*)",
      "Bash(atuin:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/glab-cli/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.config/hub/**)",
      "Read(~/.config/heroku/**)",
      "Read(~/.config/doctl/**)",
      "Read(~/.gradle/gradle.properties)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.m2/settings-security.xml)",
      "Read(~/.minikube/**)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.gem/credentials)",
      "Read(~/.composer/auth.json)",
      "Read(~/.stripe/**)",
      "Read(~/.git-credentials)",
      "Read(~/.dotfiles-state/**)",
      "Read(~/.pgpass)",
      "Read(~/.my.cnf)",
      "Read(~/.mongorc.js)",
      "Read(**/*.tfvars)",
      "Read(**/*.ppk)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/settings.local.json)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/credentials*)",
      "Edit(**/*secret*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.azure/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/glab-cli/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.kube/config)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(~/.netrc)",
      "Edit(~/.config/hub/**)",
      "Edit(~/.config/heroku/**)",
      "Edit(~/.config/doctl/**)",
      "Edit(~/.gradle/gradle.properties)",
      "Edit(~/.m2/settings.xml)",
      "Edit(~/.m2/settings-security.xml)",
      "Edit(~/.minikube/**)",
      "Edit(~/.cargo/credentials*)",
      "Edit(~/.gem/credentials)",
      "Edit(~/.composer/auth.json)",
      "Edit(~/.stripe/**)",
      "Edit(~/.git-credentials)",
      "Edit(~/.dotfiles-state/**)",
      "Edit(~/.pgpass)",
      "Edit(~/.my.cnf)",
      "Edit(~/.mongorc.js)",
      "Edit(**/*.tfvars)",
      "Edit(**/*.ppk)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p12)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/projects/*/memory/**)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git clean -fd:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(chmod -R 777:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 666:*)",
      "Bash(chmod -R 755 /*)",
      "Bash(chown -R:*)",
      "Bash(sudo:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-security.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-code-no-emoji.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-scope-audit.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-dep-audit.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-banner.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "sandbox": {
    "enabled": false
  },
  "tui": "fullscreen"
}
