      "Bash(type:*)",
      "Bash(realpath:*)",
      "Bash(readlink:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(curl:*)",
      "Bash(tar:*)",
      "Bash(unzip:*)",
      "Bash(sha256sum:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(cut:*)",
      "Bash(uniq:*)",
      "Bash(tr:*)",
      "Bash(sed -n:*)",
      "Bash(awk:*)",
      "Bash(xargs:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
