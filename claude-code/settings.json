  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-security.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-code-no-emoji.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-scope-audit.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-dep-audit.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-banner.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "excludedCommands": ["glab *", "gh *", "docker *"],
    "credentials": {
      "files": [
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" },
        { "path": "~/.azure", "mode": "deny" },
        { "path": "~/.config/gcloud", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" },
        { "path": "~/.config/glab-cli", "mode": "deny" },
        { "path": "~/.config/heroku", "mode": "deny" },
        { "path": "~/.config/doctl", "mode": "deny" },
        { "path": "~/.stripe", "mode": "deny" },
        { "path": "~/.git-credentials", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" },
        { "path": "~/.pgpass", "mode": "deny" },
        { "path": "~/.my.cnf", "mode": "deny" },
        { "path": "~/.mongorc.js", "mode": "deny" },
        { "path": "~/.minikube", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" },
        { "path": "~/.pypirc", "mode": "deny" },
        { "path": "~/.kube/config", "mode": "deny" },
        { "path": "~/.docker/config.json", "mode": "deny" },
        { "path": "~/.terraform.d/credentials.tfrc.json", "mode": "deny" },
        { "path": "~/.m2/settings.xml", "mode": "deny" },
        { "path": "~/.m2/settings-security.xml", "mode": "deny" },
        { "path": "~/.gradle/gradle.properties", "mode": "deny" },
        { "path": "~/.gem/credentials", "mode": "deny" },
        { "path": "~/.composer/auth.json", "mode": "deny" },
        { "path": "~/.cargo/credentials.toml", "mode": "deny" },
        { "path": "~/.claude/.credentials.json", "mode": "deny" },
        { "path": "~/.claude/settings.local.json", "mode": "deny" },
        { "path": "~/.claude.json", "mode": "deny" },
        { "path": "~/.codex/auth.json", "mode": "deny" },
        { "path": "~/.copilot", "mode": "deny" },
        { "path": "~/.dotfiles-state", "mode": "deny" },
        { "path": "~/.bash_history", "mode": "deny" },
        { "path": "~/.zsh_history", "mode": "deny" },
        { "path": "~/.local/share/atuin", "mode": "deny" }
      ]
    },
    "filesystem": {
      "denyRead": ["~/.ssh"],
      "allowRead": ["~/.ssh/known_hosts"]
    },
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "console.anthropic.com",
