      "Bash(which:*)",
      "Bash(command -v:*)",
      "Bash(type:*)",
      "Bash(realpath:*)",
      "Bash(readlink:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(curl:*)",
      "Bash(tar:*)",
      "Bash(unzip:*)",
      "Bash(sha256sum:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(cut:*)",
      "Bash(uniq:*)",
      "Bash(tr:*)",
      "Bash(sed -n:*)",
      "Bash(awk:*)",
      "Bash(xargs:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
      "Bash(perl:*)",
      "Bash(python3 -c:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(make lint:*)",
      "Bash(make test:*)",
      "Bash(shellcheck:*)",
      "Bash(bash -n:*)",
      "Bash(ast-grep:*)",
      "Bash(sg:*)",
      "Bash(difft:*)",
      "Bash(sd:*)",
      "Bash(scc:*)",
      "Bash(bat:*)",
      "Bash(watchexec:*)",
      "Bash(node --version:*)",
      "Bash(npm list:*)",
      "Bash(npx:*)",
      "Bash(python3 --version:*)",
      "Bash(go version:*)",
      "Bash(rustc --version:*)",
      "Bash(claude --version:*)",
      "Bash(codex --version:*)",
      "Bash(dpkg -l:*)",
      "Bash(snap list:*)",
      "Bash(apt list:*)",
      "Bash(brew list:*)",
      "Bash(chmod:*)",
      "Bash(atuin:*)"
    ],
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh api:*)",
      "Bash(glab mr create:*)",
      "Bash(glab mr update:*)",
      "Bash(glab mr note:*)",
      "Bash(glab mr approve:*)",
      "Bash(glab mr merge:*)",
      "Bash(glab mr close:*)",
      "Bash(glab issue create:*)",
      "Bash(glab issue note:*)",
      "Bash(glab issue update:*)",
      "Bash(glab issue close:*)",
      "Bash(glab api:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/credentials)",
      "Read(**/secrets.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/client_secret*.json)",
      "Read(**/*.env)",
      "Read(**/service-account*.json)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/.netrc)",
      "Read(**/.htpasswd)",
      "Read(**/kubeconfig)",
      "Read(**/.dockercfg)",
      "Read(**/*.asc)",
      "Read(**/*.gpg)",
      "Read(**/*.kdbx)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.config/hub/**)",
      "Read(~/.gradle/gradle.properties)",
      "Read(~/.cargo/credentials*)",
      "Read(**/*.tfvars)",
      "Read(**/*.ppk)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Edit(.env)",
      "Edit(**/credentials)",
      "Edit(**/secrets.json)",
      "Edit(**/secrets.yaml)",
      "Edit(**/secrets.yml)",
      "Edit(**/client_secret*.json)",
      "Edit(**/*.env)",
      "Edit(**/service-account*.json)",
      "Edit(**/id_rsa)",
      "Edit(**/id_ed25519)",
      "Edit(**/id_ecdsa)",
      "Edit(**/.netrc)",
      "Edit(**/.htpasswd)",
      "Edit(**/kubeconfig)",
      "Edit(**/.dockercfg)",
      "Edit(**/*.asc)",
      "Edit(**/*.gpg)",
      "Edit(**/*.kdbx)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.kube/config)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(~/.config/hub/**)",
      "Edit(~/.gradle/gradle.properties)",
      "Edit(~/.cargo/credentials*)",
      "Edit(**/*.tfvars)",
      "Edit(**/*.ppk)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p12)",
      "Edit(~/.claude/projects/*/memory/**)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git clean -fd:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(chmod -R 777:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 666:*)",
      "Bash(chmod -R 755 /*)",
      "Bash(chown -R:*)",
      "Bash(sudo:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/credentials.*)",
      "Edit(**/credentials.*)",
      "Read(**/.credentials*)",
      "Edit(**/.credentials*)",
      "Read(**/*.tfstate*)",
      "Edit(**/*.tfstate*)",
      "Read(~/.m2/settings*)",
      "Edit(~/.m2/settings*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-security.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-code-no-emoji.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-scope-audit.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-dep-audit.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-banner.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-create.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-remove.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "console.anthropic.com",
        "statsig.anthropic.com",
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "codeload.github.com",
        "ghcr.io",
        "gitlab.com",
        "registry.gitlab.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "proxy.golang.org",
        "sum.golang.org",
        "developer.mozilla.org",
        "stackoverflow.com",
        "stackexchange.com",
        "*.stackexchange.com",
        "docs.python.org",
        "nodejs.org",
        "doc.rust-lang.org",
        "docs.rs",
        "pkg.go.dev",
        "go.dev",
        "golang.org",
        "www.typescriptlang.org",
        "learn.microsoft.com",
        "developer.apple.com",
        "kubernetes.io",
        "man7.org",
        "linux.die.net"
      ],
      "allowUnixSockets": [
        "/private/tmp/com.apple.launchd.*/Listeners"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh"
      ],
      "allowRead": [
        "~/.ssh/known_hosts",
        "~/.ssh/config"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.azure",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.config/glab-cli",
          "mode": "deny"
        },
        {
          "path": "~/.config/heroku",
          "mode": "deny"
        },
        {
          "path": "~/.config/doctl",
          "mode": "deny"
        },
        {
          "path": "~/.stripe",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.pgpass",
          "mode": "deny"
        },
        {
          "path": "~/.my.cnf",
          "mode": "deny"
        },
        {
          "path": "~/.mongorc.js",
          "mode": "deny"
        },
        {
          "path": "~/.minikube",
          "mode": "deny"
        },
        {
          "path": "~/.terraform.d/credentials.tfrc.json",
          "mode": "deny"
        },
        {
          "path": "~/.gem/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.composer/auth.json",
          "mode": "deny"
        },
        {
          "path": "~/.cargo/credentials.toml",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/.claude/settings.local.json",
          "mode": "deny"
        },
        {
          "path": "~/.claude.json",
          "mode": "deny"
        },
        {
          "path": "~/.codex/auth.json",
          "mode": "deny"
        },
        {
          "path": "~/.copilot",
          "mode": "deny"
        },
        {
          "path": "~/.dotfiles-state",
          "mode": "deny"
        },
        {
          "path": "~/.bash_history",
          "mode": "deny"
        },
        {
          "path": "~/.zsh_history",
          "mode": "deny"
        },
        {
          "path": "~/.local/share/atuin",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "glab *",
      "gh *",
      "docker *",
      "git worktree *",
      "git checkout *",
      "devcontainer *"
    ]
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "theme": "dark"
}
