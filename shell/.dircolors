# VS Code Dark+ Inspired Color Scheme for dircolors
# Optimized for dark terminal backgrounds with high visibility
#
# Color codes (ANSI):
# 00=none 01=bold 04=underscore 05=blink 07=reverse 08=concealed
# Text colors: 30=black 31=red 32=green 33=yellow 34=blue 35=magenta 36=cyan 37=white
# Bright text: 90=bright-black 91=bright-red 92=bright-green 93=bright-yellow
#              94=bright-blue 95=bright-magenta 96=bright-cyan 97=bright-white
# Background: 40=black 41=red 42=green 43=yellow 44=blue 45=magenta 46=cyan 47=white

# Terminal type
TERM Eterm
TERM ansi
TERM *color*
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM dtterm
TERM gnome
TERM hurd
TERM jfbterm
TERM konsole
TERM kterm
TERM linux
TERM linux-c
TERM mlterm
TERM putty
TERM rxvt*
TERM screen*
TERM st
TERM terminator
TERM tmux*
TERM vt100
TERM xterm*

# Basic file types
NORMAL 00                # normal file
FILE 00                  # regular file
RESET 0                  # reset to normal color
DIR 01;96               # directory - BRIGHT CYAN (highly visible on dark)
LINK 01;95              # symbolic link - BRIGHT MAGENTA
MULTIHARDLINK 00        # multiple hard links
FIFO 01;33              # pipe - BRIGHT YELLOW
SOCK 01;35              # socket - MAGENTA
DOOR 01;35              # door
BLK 01;33               # block device
CHR 01;33               # character device
ORPHAN 01;31            # orphaned symlink - BRIGHT RED
MISSING 01;31           # missing file - BRIGHT RED
SETUID 37;41            # file with setuid bit - WHITE ON RED
SETGID 30;43            # file with setgid bit - BLACK ON YELLOW
CAPABILITY 30;41        # file with capability
STICKY_OTHER_WRITABLE 01;92  # sticky directory writable by others - BRIGHT GREEN
OTHER_WRITABLE 01;93    # directory writable by others - BRIGHT YELLOW
STICKY 01;94            # sticky directory - BRIGHT BLUE
EXEC 01;92              # executable - BRIGHT GREEN

