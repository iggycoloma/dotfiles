{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-security.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-commit-validate.sh",
            "if": "Bash(git commit*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-security.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-code-no-emoji.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
