{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/pre-security.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/pre-code-no-emoji.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
