{
  "description": "Shared guardrails and lifecycle observability for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agent-hooks/hook-health.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.agent-hooks/session-audit.sh codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agent-hooks/session-audit.sh codex",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|mcp__.*(read|write|edit).*)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/pre-security.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/pre-code-no-emoji.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agent-hooks/pre-hookspath-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agent-hooks/post-dep-audit.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.agent-hooks/tool-telemetry.sh codex",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agent-hooks/post-scope-audit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agent-hooks/subagent-audit.sh codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agent-hooks/subagent-audit.sh codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
