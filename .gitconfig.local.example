# Local Git Configuration
# Copy this file to ~/.gitconfig.local and customize with your details

[user]
	name = Your Name
	email = your.email@example.com
	# Uncomment to enable commit signing
	# signingkey = YOUR_GPG_KEY_ID

[github]
	user = yourusername

# Uncomment to enable commit signing
# [commit]
# 	gpgsign = true

# Uncomment for different diff tool
# [diff]
# 	tool = vimdiff

# Uncomment for different merge tool
# [merge]
# 	tool = vimdiff

# Add any other personal git configurations here
