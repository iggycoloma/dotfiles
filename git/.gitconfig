[core]
	# editor: intentionally unset so git inherits $GIT_EDITOR / $VISUAL / $EDITOR.
	# shell/exports.sh detects nvim -> vim -> vi at shell-init time; hard-coding
	# `editor = vim` here breaks rebase / commit in environments where vim isn't
	# installed (e.g. devcontainers that ship vi/nano only).
	excludesfile = ~/.gitignore_global
	autocrlf = input
	pager = delta
	# Use a global hooks directory so guardrails apply to all repos
	hooksPath = ~/.config/git/hooks

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	side-by-side = false
	line-numbers = true
	syntax-theme = OneHalfDark

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[pull]
	rebase = false

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[init]
	defaultBranch = main

[worktree]
	# Relative .git pointers make worktrees relocatable across bind-mount
	# boundaries (host path vs /workspaces/... in devcontainers) and are
	# required by `devcontainer up --mount-git-worktree-common-dir`.
	# Applies to every creator: claude --worktree, plain git worktree add.
	# Git < 2.48 ignores this key silently and keeps absolute pointers;
	# migrate pre-existing worktrees with `git worktree repair`.
	useRelativePaths = true

[commit]
	# Use a conventional-commit friendly template
	template = ~/.gitmessage
	# gpgsign is enabled by install.sh when an SSH key is available

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = green
	changed = yellow
	untracked = red

[alias]
	# Short aliases
	s = status -sb
	a = add
	aa = add --all
	c = commit -v
	cm = commit -m
	ca = commit --amend
	can = commit --amend --no-edit
	co = checkout
	cob = checkout -b
	b = branch
	ba = branch -a
	bd = branch -d
	bD = branch -D
	m = merge
	r = rebase
	ri = rebase -i
	rc = rebase --continue
	ra = rebase --abort

	# Push/Pull
	p = push
	pf = push --force-with-lease
	pl = pull
	plr = pull --rebase
	f = fetch
	fa = fetch --all

	# Diff
	d = diff
	ds = diff --staged
	dc = diff --cached

	# Log aliases
	l = log --oneline --graph --decorate
	la = log --oneline --graph --decorate --all
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all

	# Stash
	st = stash
	stp = stash pop
	stl = stash list
	sta = stash apply

	# Reset
	unstage = reset HEAD --
	undo = reset --soft HEAD^
	rh = reset HEAD
	rhh = reset --hard HEAD

	# Clean
	clean-all = clean -fdx

	# Show
	last = log -1 HEAD --stat
	contributors = shortlog --summary --numbered

	# Utilities
	aliases = config --get-regexp alias
	branches = branch -a
	remotes = remote -v
	tags = tag -l
