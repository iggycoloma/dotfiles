#!/usr/bin/env bash
# Global pre-commit hook: secret scanning via gitleaks
#
# Scans staged changes for secrets (API keys, passwords, tokens).
# Silently passes if gitleaks is not installed.
# Applied globally via core.hooksPath = ~/.config/git/hooks
#
# Bypass (emergency): git commit --no-verify

# Run repo-level pre-commit.local hook first (if present).
# --git-common-dir, not --git-dir: in a linked worktree --git-dir is the
# per-worktree admin dir (.git/worktrees/<name>), so a repo's local hook
# would run from the main checkout but silently not from its worktrees.
repo_hook="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/hooks/pre-commit.local"
if [[ -x "$repo_hook" ]]; then
    "$repo_hook" "$@" || exit $?
fi

# Gitleaks secret scanning (skip if not installed)
if command -v gitleaks &>/dev/null; then
    gitleaks protect --staged --no-banner
    exit_code=$?
    if [[ $exit_code -ne 0 ]]; then
        echo ""
        echo "ERROR: gitleaks detected secrets in staged changes."
        echo "Review the findings above and remove secrets before committing."
        echo ""
        echo "If this is a false positive, you can:"
        echo "  1. Add a .gitleaksignore file with the fingerprint"
        echo "  2. Use: git commit --no-verify (not recommended)"
        exit 1
    fi
fi
