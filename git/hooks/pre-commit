#!/usr/bin/env bash
# Global pre-commit hook: secret scanning via gitleaks
#
# Scans staged changes for secrets (API keys, passwords, tokens).
# Warns if gitleaks is unavailable; forge push protection remains authoritative.
# Applied globally via core.hooksPath = ~/.config/git/hooks
#
# Bypass (emergency): git commit --no-verify

# Run repo-level pre-commit.local hook first (if present).
# --git-common-dir, not --git-dir: in a linked worktree --git-dir is the
# per-worktree admin dir (.git/worktrees/<name>), so a repo's local hook
# would run from the main checkout but silently not from its worktrees.
repo_hook="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/hooks/pre-commit.local"
if [[ -x "$repo_hook" ]]; then
    "$repo_hook" "$@" || exit $?
fi

# Opt-in project hooks: a repo runs `git config dotfiles.projectHooks true`
# once and its tracked .githooks/<hook> chains here, instead of setting
# core.hooksPath, which would replace this dispatcher and silently disable
# secret scanning. --local only: .githooks/ arrives with the clone, so the
# trust grant must live in the one file a clone cannot ship -- this
# repository's own config (shared across its worktrees). A global or
# system-level setting is deliberately ignored; honoring it would make
# every cloned repo's hooks run on the next commit. Resolved via
# --show-toplevel so each worktree runs its own checked-out revision.
if [[ "$(git config --local --type=bool dotfiles.projectHooks 2>/dev/null)" == "true" ]]; then
    toplevel="$(git rev-parse --show-toplevel 2>/dev/null)"
    project_hook="$toplevel/.githooks/pre-commit"
    if [[ -n "$toplevel" && -x "$project_hook" ]]; then
        "$project_hook" "$@" || exit $?
    elif [[ -n "$toplevel" && -e "$project_hook" ]]; then
        echo "warning: $project_hook was ignored because it is not executable (chmod +x to run it)" >&2
    fi
fi

# Gitleaks secret scanning.
if command -v gitleaks &>/dev/null; then
    gitleaks git --staged --no-banner --redact .
    exit_code=$?
    if [[ $exit_code -ne 0 ]]; then
        echo ""
        echo "ERROR: gitleaks detected secrets in staged changes."
        echo "Review the findings above and remove secrets before committing."
        echo ""
        echo "If this is a false positive, you can:"
        echo "  1. Add a .gitleaksignore file with the fingerprint"
        echo "  2. Use: git commit --no-verify (not recommended)"
        exit 1
    fi
else
    echo "warning: gitleaks is unavailable; staged changes were not scanned for secrets" >&2
fi
