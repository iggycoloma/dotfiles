#!/usr/bin/env bash
# Global commit-msg hook (applies to all repos via core.hooksPath)
# Enforces clean commit messages similar to Claude Code guardrails:
# - Blocks AI tool attribution and co-author lines
# - Blocks emoji characters
# - Enforces Conventional Commits subject format
# - Enforces a minimum subject length

set -euo pipefail

# Prevent infinite recursion
if [[ "${DOTFILES_GLOBAL_HOOK_RUNNING:-}" == "1" ]]; then
  exit 0
fi
export DOTFILES_GLOBAL_HOOK_RUNNING=1

MSG_FILE=${1:-}
if [[ -z "${MSG_FILE}" || ! -f "${MSG_FILE}" ]]; then
  echo "commit-msg: message file not found: ${MSG_FILE}" >&2
  exit 1
fi

# If a repo-level commit-msg hook exists, run it first (allows repo to modify the message).
# Supports either .git/hooks/commit-msg.local or .git/hooks/commit-msg.
LOCAL_HOOKS_DIR="$(git rev-parse --git-dir 2>/dev/null)/hooks" || true
if [[ -n "${LOCAL_HOOKS_DIR:-}" ]]; then
  if [[ -x "${LOCAL_HOOKS_DIR}/commit-msg.local" ]]; then
    "${LOCAL_HOOKS_DIR}/commit-msg.local" "${MSG_FILE}" || exit $?
  elif [[ -x "${LOCAL_HOOKS_DIR}/commit-msg" && "${LOCAL_HOOKS_DIR}/commit-msg" != "$0" ]]; then
    "${LOCAL_HOOKS_DIR}/commit-msg" "${MSG_FILE}" || exit $?
  fi
fi

# Read full message after any repo hook modifications (strip comment lines)
FULL_MSG=$(sed '/^#/d' "${MSG_FILE}")
SUBJECT=$(printf '%s\n' "${FULL_MSG}" | sed -n '1p')

# Allow merge commits to pass through (auto-generated by Git)
if printf '%s' "${SUBJECT}" | grep -qE '^[Mm]erge\b'; then
  exit 0
fi

# 1) Block AI tool attribution (case-insensitive)
# Match attribution phrases, not bare tool names -- file paths like
# ~/.copilot/ or "Claude Code configuration" are technical references.
if printf '%s' "${FULL_MSG}" | grep -qiE '(generated (with|by)|powered by|created (with|by)|written (with|by)|assisted by|produced by|authored by|built with|made with).*(claude|anthropic|gpt|openai|copilot|gemini|cursor|windsurf|ai)' ||
   printf '%s' "${FULL_MSG}" | grep -qiE '(claude|anthropic|gpt|openai|copilot|gemini|cursor|windsurf|ai).*(generated|powered|created|wrote|assisted|produced|authored|built)' ||
   printf '%s' "${FULL_MSG}" | grep -qiE '(claude\.com|anthropic\.com|ai-generated|ai generated)'; then
  cat >&2 <<'ERR'
Commit message contains AI tool attribution.

Please remove any of the following from the message:
  - Attribution phrases ("generated by", "written with", "powered by")
  - Vendor URLs (claude.com, anthropic.com)
  - "AI-generated" or "AI generated"

Tool names in technical context (file paths, config references) are fine.
Use: git commit --no-verify to bypass (not recommended).
ERR
  exit 1
fi

# 2) Block co-authoring tags
if printf '%s' "${FULL_MSG}" | grep -qiE 'co-authored-by:|co-authored by:'; then
  cat >&2 <<'ERR'
❌ Commit message contains co-authoring tags.

Please remove lines like:
  Co-Authored-By: ...
  Co-authored by: ...

Use: git commit --no-verify to bypass (not recommended).
ERR
  exit 1
fi

# 3) Block emoji characters (best-effort; skip if grep -P unavailable)
if command -v grep >/dev/null 2>&1 && grep -P '' </dev/null >/dev/null 2>&1; then
  if printf '%s' "${FULL_MSG}" | grep -qP '[\x{1F300}-\x{1F9FF}\x{2600}-\x{26FF}\x{2700}-\x{27BF}\x{1F000}-\x{1F02F}\x{1F0A0}-\x{1F0FF}\x{1F100}-\x{1F64F}\x{1F680}-\x{1F6FF}\x{1F900}-\x{1F9FF}\x{1FA00}-\x{1FA6F}\x{1FA70}-\x{1FAFF}\x{2300}-\x{23FF}\x{2B50}\x{2B55}\x{231A}\x{231B}\x{2328}\x{23CF}\x{23E9}-\x{23FF}\x{24C2}\x{25AA}\x{25AB}\x{25B6}\x{25C0}\x{25FB}-\x{25FE}\x{2600}-\x{2604}\x{260E}\x{2611}\x{2614}\x{2615}\x{2618}\x{261D}\x{2620}\x{2622}\x{2623}\x{2626}\x{262A}\x{262E}\x{262F}\x{2638}-\x{263A}\x{2640}\x{2642}\x{2648}-\x{2653}\x{265F}\x{2660}\x{2663}\x{2665}\x{2666}\x{2668}\x{267B}\x{267E}\x{267F}\x{2692}-\x{2697}\x{2699}\x{269B}\x{269C}\x{26A0}\x{26A1}\x{26A7}\x{26AA}\x{26AB}\x{26B0}\x{26B1}\x{26BD}\x{26BE}\x{26C4}\x{26C5}\x{26C8}\x{26CE}\x{26CF}\x{26D1}\x{26D3}\x{26D4}\x{26E9}\x{26EA}\x{26F0}-\x{26F5}\x{26F7}-\x{26FA}\x{26FD}\x{2702}\x{2705}\x{2708}-\x{270D}\x{270F}\x{2712}\x{2714}\x{2716}\x{271D}\x{2721}\x{2728}\x{2733}\x{2734}\x{2744}\x{2747}\x{274C}\x{274E}\x{2753}-\x{2755}\x{2757}\x{2763}\x{2764}\x{2795}-\x{2797}\x{27A1}\x{27B0}\x{27BF}\x{2934}\x{2935}\x{2B05}-\x{2B07}\x{2B1B}\x{2B1C}\x{2B50}\x{2B55}\x{3030}\x{303D}\x{3297}\x{3299}]'; then
    cat >&2 <<'ERR'
❌ Commit message contains emoji characters.

Please remove emojis from the commit message.

Use: git commit --no-verify to bypass (not recommended).
ERR
    exit 1
  fi
fi

# 4) Enforce Conventional Commits on the subject line
VALID_TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if ! printf '%s' "${SUBJECT}" | grep -qE "^(${VALID_TYPES})(\([a-z][a-z0-9-]*\))?:[[:space:]][a-z].+"; then
  cat >&2 <<ERR
⚠️  Commit message doesn't follow Conventional Commits.

Expected: <type>[optional scope]: <description>
- Description must start with lowercase letter
- Valid types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
- Optional scope must start with letter, contain only lowercase letters, numbers, and hyphens

Example: feat(auth): add user login functionality

Current: ${SUBJECT:-<empty>}

Tip: A helpful template is configured via commit.template (~/.gitmessage).
Use: git commit --no-verify to bypass.
ERR
  exit 1
fi

# 5) Minimum subject length (>= 10)
SUBJECT_LEN=${#SUBJECT}
if (( SUBJECT_LEN < 10 )); then
  cat >&2 <<ERR
⚠️  Commit subject is too short (${SUBJECT_LEN} chars). Please provide a more descriptive summary (min 10).
Use: git commit --no-verify to bypass.
ERR
  exit 1
fi

exit 0
