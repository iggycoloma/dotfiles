#!/usr/bin/env bash
# Global pre-push backstop: scan every outgoing commit range for secrets.

remote_name="${1:-}"
remote_location="${2:-}"
input_file=$(mktemp)
trap 'rm -f "$input_file"' EXIT
cat > "$input_file"

# This tracked dispatcher owns the hook slot, so explicitly preserve Git LFS.
if command -v git-lfs &>/dev/null; then
    git lfs pre-push "$remote_name" "$remote_location" < "$input_file" || exit $?
fi

repo_hook="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/hooks/pre-push.local"
if [[ -x "$repo_hook" ]]; then
    "$repo_hook" "$@" < "$input_file" || exit $?
fi

# Opt-in project hooks (`git config dotfiles.projectHooks true`): chain the
# repo's tracked .githooks/pre-push instead of letting core.hooksPath
# replace this dispatcher and disable the secret-scanning backstop below.
if [[ "$(git config --type=bool dotfiles.projectHooks 2>/dev/null)" == "true" ]]; then
    project_hook="$(git rev-parse --show-toplevel 2>/dev/null)/.githooks/pre-push"
    if [[ -x "$project_hook" ]]; then
        "$project_hook" "$@" < "$input_file" || exit $?
    fi
fi

if ! command -v gitleaks &>/dev/null; then
    printf 'warning: gitleaks is unavailable; outgoing commits were not scanned for secrets\n' >&2
    exit 0
fi

zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -n "$local_sha" && "$local_sha" != "$zero" ]] || continue
    if [[ "$remote_sha" == "$zero" ]]; then
        log_opts="$local_sha --not --remotes=$remote_name"
    else
        log_opts="$remote_sha..$local_sha"
    fi
    if ! gitleaks git --no-banner --redact --log-opts="$log_opts" .; then
        printf 'ERROR: gitleaks detected a secret in commits being pushed from %s to %s.\n' "$local_ref" "$remote_ref" >&2
        exit 1
    fi
done < "$input_file"

exit 0
